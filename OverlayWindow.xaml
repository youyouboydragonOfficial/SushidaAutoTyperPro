<Window x:Class="SushidaAutoTyper.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Region Selector"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#33000000"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        Cursor="Cross"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        KeyDown="Window_KeyDown">

    <Canvas x:Name="OverlayCanvas">
        <!-- Selection Rectangle -->
        <Rectangle x:Name="SelectionBox"
                   Stroke="#00E5FF"
                   StrokeThickness="2"
                   Fill="#2200E5FF"
                   Visibility="Collapsed"/>

        <Border x:Name="InstructionCard"
                Canvas.Left="20" Canvas.Top="20"
                Background="#EE1E1E2E"
                CornerRadius="8" Padding="15,10"
                BorderBrush="#00E5FF" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="🎯 寿司打・タイピングゲームの文字枠をマウスでドラッグ選択してください"
                           Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="[ESC] キーでキャンセル | ドラッグ完了で領域を決定します"
                           Foreground="#A6ADC8" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="SizeInfoText"
                   Foreground="#00E5FF"
                   FontSize="12"
                   FontWeight="Bold"
                   Visibility="Collapsed"/>
    </Canvas>
</Window>
