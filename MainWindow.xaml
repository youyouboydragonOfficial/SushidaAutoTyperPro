<Window x:Class="SushidaAutoTyper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sushida &amp; Typing Game Auto-Typer Pro"
        Height="680" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#11111B"
        Foreground="#CDD6F4"
        FontFamily="Segoe UI, Segoe UI Variable">

    <Window.Resources>
        <!-- Custom Styles -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E1E2E"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="🍣" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sushida &amp; Typing Game Auto-Typer Pro" FontSize="18" FontWeight="Bold" Foreground="#00E5FF"/>
                        <TextBlock Text="寿司打・Unityゲーム・Webタイピング対応 自動高速タイピングツール v1.0.0" FontSize="11" Foreground="#A6ADC8"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#313244" CornerRadius="12" Padding="10,4">
                        <TextBlock Text="F8: 開始 | F9: 一時停止 | F10: 緊急停止" FontSize="11" Foreground="#F5E0DC" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            
            <!-- TAB 1: OCR Screen Recognition -->
            <TabItem Header="📸 画面OCR自動連打モード">
                <Grid Background="#1E1E2E" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Region Controls -->
                    <Border Grid.Row="0" Background="#252538" CornerRadius="8" Padding="16" Margin="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="タイピング表示エリアの範囲指定" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="RegionStatusText" Text="未選択 (「領域を選択」を押して寿司打の文字部分をドラッグしてください)" FontSize="12" Foreground="#BAC2DE" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="SelectRegionBtn" Grid.Column="1" Content="🎯 領域を選択 (Select Area)" Click="SelectRegionBtn_Click" Background="#89B4FA" Foreground="#11111B"/>
                        </Grid>
                    </Border>

                    <!-- OCR Settings -->
                    <Grid Grid.Row="1" Margin="12,0,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#252538" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Scan Interval (スキャン周期)" FontSize="12" Foreground="#A6ADC8"/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock x:Name="ScanIntervalValText" Text="150 ms" DockPanel.Dock="Right" Foreground="#00E5FF" FontWeight="Bold"/>
                                    <Slider x:Name="ScanIntervalSlider" Minimum="50" Maximum="1000" Value="150" SmallChange="10" ValueChanged="ScanIntervalSlider_ValueChanged"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#252538" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="文字化け防止・画像二値化フィルタ" FontSize="12" Foreground="#A6ADC8"/>
                                <CheckBox x:Name="BinarizationCheckBox" Content="自動コントラスト最適化＆Unicode正規化" IsChecked="True" Foreground="#CDD6F4" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Live OCR Preview -->
                    <Border Grid.Row="2" Background="#252538" CornerRadius="8" Padding="14" Margin="12,0,12,12">
                        <DockPanel>
                            <TextBlock Text="OCR Live Recognition Preview:" DockPanel.Dock="Top" FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,6"/>
                            <TextBox x:Name="OcrPreviewBox" IsReadOnly="True" Background="#181825" Foreground="#A6E3A1" FontFamily="Consolas" FontSize="15" Padding="10" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Direct Custom Text Typing -->
            <TabItem Header="⌨️ 高速テキストタイピングモード">
                <Grid Background="#1E1E2E" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Speed & Hardware Options -->
                    <Border Grid.Row="0" Background="#252538" CornerRadius="8" Padding="14" Margin="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="タイピング速度 (打鍵間隔)" FontSize="12" Foreground="#A6ADC8"/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock x:Name="DelayValText" Text="20 ms (3,000 CPM)" DockPanel.Dock="Right" Foreground="#00E5FF" FontWeight="Bold"/>
                                    <Slider x:Name="DelaySlider" Minimum="0" Maximum="300" Value="20" SmallChange="5" ValueChanged="DelaySlider_ValueChanged"/>
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="入力互換性＆動作オプション" FontSize="12" Foreground="#A6ADC8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="UnityHardwareModeCheckBox" Content="🎮 Unity / DirectInput (ScanCode)" IsChecked="True" Foreground="#A6E3A1" Margin="0,0,15,0" ToolTip="Unityゲーム・Canvas等でハードウェアキー入力をシミュレート"/>
                                    <CheckBox x:Name="HumanizerCheckBox" Content="👤 人間らしい揺らぎ" IsChecked="False" Foreground="#CDD6F4" ToolTip="キー入力間隔に微小なランダム性を付与"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Text Box -->
                    <Border Grid.Row="1" Background="#252538" CornerRadius="8" Padding="14" Margin="12,0,12,12">
                        <DockPanel>
                            <TextBlock Text="自動送信するテキストを入力または貼り付けしてください:" DockPanel.Dock="Top" FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,6"/>
                            <TextBox x:Name="CustomScriptInput" AcceptsReturn="True" TextWrapping="Wrap" Background="#181825" Foreground="#CDD6F4" FontFamily="Consolas" FontSize="14" Padding="10" VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Border>

                    <!-- Helper Tools -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,0,12,12" HorizontalAlignment="Right">
                        <Button Content="ひらがな→ローマ字変換" Click="ConvertKanaBtn_Click" Background="#CBA6F7" Foreground="#11111B" Margin="0,0,8,0"/>
                        <Button Content="テキストクリア" Click="ClearTextBtn_Click" Background="#45475A"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: Sushida Helper & Manual -->
            <TabItem Header="ℹ️ 寿司打ガイド &amp; ホットキー">
                <Grid Background="#1E1E2E" Margin="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <TextBlock Text="寿司打 (Sushida) 攻略・使い方ガイド" FontSize="16" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,10"/>
                            
                            <Border Background="#252538" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="💡 基本的な使い方手順" FontSize="14" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,0,0,6"/>
                                    <TextBlock Text="1. ブラウザで寿司打（またはお好みのタイピングゲーム）を開きます。" FontSize="12" Margin="0,2"/>
                                    <TextBlock Text="2. 「画面OCR自動連打モード」の「🎯 領域を選択」ボタンを押します。" FontSize="12" Margin="0,2"/>
                                    <TextBlock Text="3. 寿司打の画面上で、ローマ字が表示される枠部分をドラッグして囲みます。" FontSize="12" Margin="0,2"/>
                                    <TextBlock Text="4. [F8] キーを押すと自動タイピングが開始されます！" FontSize="12" Margin="0,2"/>
                                    <TextBlock Text="5. [F9] で一時停止、[F10] で緊急停止できます。" FontSize="12" Margin="0,2"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#252538" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🎮 Unity / WebGL / Canvasタイピングゲーム対応について" FontSize="14" FontWeight="Bold" Foreground="#FAB387" Margin="0,0,0,6"/>
                                    <TextBlock Text="Unityで作成されたタイピングゲームやWebGL Canvasアプリは、一般的なキーボード入力イベントを無視する場合があります。" TextWrapping="Wrap" FontSize="12" Margin="0,2"/>
                                    <TextBlock Text="本アプリは DirectInput 対応のハードウェアスキャンコード (ScanCode Mode) を自動送信するため、Unity製タイピングゲームでも確実にキー入力を認識します。" TextWrapping="Wrap" FontSize="12" Margin="0,2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Log Console -->
        <Border Grid.Row="2" Background="#181825" CornerRadius="8" Padding="10" Margin="0,8,0,10">
            <DockPanel>
                <TextBlock Text="STATUS LOG" DockPanel.Dock="Top" FontSize="10" FontWeight="Bold" Foreground="#A6ADC8" Margin="0,0,0,4"/>
                <TextBox x:Name="LogConsole" Height="70" IsReadOnly="True" Background="Transparent" Foreground="#F5E0DC" BorderThickness="0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <!-- Control Action Bar -->
        <Border Grid.Row="3" Background="#1E1E2E" CornerRadius="10" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Typed:" FontSize="12" Foreground="#A6ADC8" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TypedCountText" Text="0 chars" FontSize="12" FontWeight="Bold" Foreground="#00E5FF"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="StartBtn" Content="▶ 開始 (F8)" Click="StartBtn_Click" Background="#A6E3A1" Foreground="#11111B" Width="120" Margin="0,0,8,0"/>
                    <Button x:Name="PauseBtn" Content="⏸ 一時停止 (F9)" Click="PauseBtn_Click" Background="#FAB387" Foreground="#11111B" Width="130" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button x:Name="StopBtn" Content="⏹ 停止 (F10)" Click="StopBtn_Click" Background="#F38BA8" Foreground="#11111B" Width="110" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
