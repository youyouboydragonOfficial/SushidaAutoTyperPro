<Window x:Class="SushidaAutoTyper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sushida &amp; Typing Game Auto-Typer Pro"
        Height="580" Width="720"
        MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#11111B"
        Foreground="#CDD6F4"
        FontFamily="Segoe UI, Segoe UI Variable">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E1E2E"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="🍣" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sushida &amp; Typing Game Auto-Typer Pro" FontSize="15" FontWeight="Bold" Foreground="#00E5FF"/>
                        <TextBlock Text="自由サイズ変更＆ダブルウィンドウ（分割画面）対応 v1.0.0" FontSize="10" Foreground="#A6ADC8"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="AlwaysOnTopCheckBox" Content="📌 最前面固定" Checked="AlwaysOnTopCheckBox_CheckedChanged" Unchecked="AlwaysOnTopCheckBox_CheckedChanged" Foreground="#A6E3A1" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="📌 ショートカット作成" Click="CreateShortcutYes_Click" Background="#313244" Foreground="#89B4FA" FontSize="11" Padding="6,3" Margin="0,0,8,0"/>
                    <Border Background="#313244" CornerRadius="10" Padding="8,3">
                        <TextBlock Text="F8:開始 | F9:停止" FontSize="11" Foreground="#F5E0DC" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            
            <!-- TAB 1: OCR Screen Recognition -->
            <TabItem Header="📸 画面OCR自動連打モード">
                <Grid Background="#1E1E2E" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">

                            <!-- Desktop Shortcut Prompt Banner -->
                            <Border x:Name="ShortcutPromptBanner" Background="#252538" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" Visibility="Collapsed" BorderBrush="#00E5FF" BorderThickness="1">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="📌" FontSize="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="デスクトップにショートカットを追加しますか？" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button Content="いる (はい)" Click="CreateShortcutYes_Click" Background="#A6E3A1" Foreground="#11111B" Margin="0,0,6,0" Padding="10,4" FontSize="11"/>
                                        <Button Content="いらない" Click="CreateShortcutNo_Click" Background="#45475A" Foreground="#FFFFFF" Padding="10,4" FontSize="11"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Region Selector Box -->
                            <Border Background="#252538" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="1. 画面タイピングエリアの範囲指定" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="RegionStatusText" Text="未選択 (「🎯 領域を選択」を押して寿司打の枠をドラッグしてください)" FontSize="11" Foreground="#BAC2DE" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="SelectRegionBtn" Content="🎯 領域を選択" Click="SelectRegionBtn_Click" Background="#89B4FA" Foreground="#11111B" Margin="0,0,6,0"/>
                                        <Button x:Name="TestOcrBtn" Content="🔍 テスト認識" Click="TestOcrBtn_Click" Background="#CBA6F7" Foreground="#11111B"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Key Injection Engine & OCR Filter Options -->
                            <Border Background="#252538" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="キー入力モード" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                                        <ComboBox x:Name="InputModeComboBox" Margin="0,2,0,0" Padding="4,3" Background="#181825" Foreground="#FFFFFF" FontSize="11">
                                            <ComboBoxItem Content="🌐 標準Webブラウザ・寿司打用" IsSelected="True"/>
                                            <ComboBoxItem Content="🎮 Unity PC・DirectInput専用"/>
                                            <ComboBoxItem Content="🛠️ 互換性レガシーモード"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <CheckBox x:Name="HighContrastBinarizationCheckBox" Content="🔥 文字二値化＆補正" IsChecked="True" Foreground="#A6E3A1" FontWeight="Bold" FontSize="11"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <CheckBox x:Name="AutoFocusCheckBox" Content="🎯 自動フォーカス" IsChecked="True" Foreground="#CDD6F4" Margin="0,0,8,0" FontSize="11"/>
                                            <CheckBox x:Name="ForceLowercaseCheckBox" Content="🔤 全小文字統一" IsChecked="True" Foreground="#00E5FF" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Scan Options -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Background="#252538" CornerRadius="8" Padding="10" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="スキャン速度 (Interval)" FontSize="11" Foreground="#A6ADC8"/>
                                        <DockPanel Margin="0,2,0,0">
                                            <TextBlock x:Name="ScanIntervalValText" Text="100 ms" DockPanel.Dock="Right" Foreground="#00E5FF" FontWeight="Bold" FontSize="11"/>
                                            <Slider x:Name="ScanIntervalSlider" Minimum="20" Maximum="500" Value="100" SmallChange="10" ValueChanged="ScanIntervalSlider_ValueChanged"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#252538" CornerRadius="8" Padding="10" Margin="4,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="タイピング打鍵間隔 (Delay)" FontSize="11" Foreground="#A6ADC8"/>
                                        <DockPanel Margin="0,2,0,0">
                                            <TextBlock x:Name="DelayValText" Text="20 ms" DockPanel.Dock="Right" Foreground="#00E5FF" FontWeight="Bold" FontSize="11"/>
                                            <Slider x:Name="DelaySlider" Minimum="0" Maximum="300" Value="20" SmallChange="5" ValueChanged="DelaySlider_ValueChanged"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Live Image & Text Preview Box -->
                    <Grid Grid.Row="1" Margin="8,0,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Live Captured Image Box -->
                        <Border Grid.Row="0" Background="#252538" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                            <DockPanel>
                                <TextBlock Text="📸 リアルタイムキャプチャ画面:" DockPanel.Dock="Top" FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,4"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="50" Background="#181825">
                                    <Image x:Name="CapturedScreenImage" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Live OCR Text Box -->
                        <Border Grid.Row="1" Background="#252538" CornerRadius="8" Padding="8">
                            <DockPanel>
                                <TextBlock Text="🔤 認識テキスト (OCR Result):" DockPanel.Dock="Top" FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,4"/>
                                <TextBox x:Name="OcrPreviewBox" IsReadOnly="True" Background="#181825" Foreground="#A6E3A1" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Padding="6" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: Direct Custom Text Typing -->
            <TabItem Header="⌨️ 高速テキストモード">
                <Grid Background="#1E1E2E" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#252538" CornerRadius="8" Padding="10" Margin="8">
                        <StackPanel>
                            <TextBlock Text="自動送信オプション" FontSize="11" Foreground="#A6ADC8"/>
                            <CheckBox x:Name="HumanizerCheckBox" Content="👤 人間らしい揺らぎ (ランダムディレイ)" IsChecked="False" Foreground="#CDD6F4" Margin="0,4,0,0" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="#252538" CornerRadius="8" Padding="10" Margin="8,0,8,8">
                        <DockPanel>
                            <TextBlock Text="自動送信するテキストを入力または貼り付けしてください:" DockPanel.Dock="Top" FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,4"/>
                            <TextBox x:Name="CustomScriptInput" AcceptsReturn="True" TextWrapping="Wrap" Background="#181825" Foreground="#CDD6F4" FontFamily="Consolas" FontSize="13" Padding="8" VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,0,8,8" HorizontalAlignment="Right">
                        <Button Content="ひらがな→ローマ字変換" Click="ConvertKanaBtn_Click" Background="#CBA6F7" Foreground="#11111B" Margin="0,0,6,0" FontSize="11"/>
                        <Button Content="テキストクリア" Click="ClearTextBtn_Click" Background="#45475A" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: Sushida Helper & Manual -->
            <TabItem Header="ℹ️ ガイド">
                <Grid Background="#1E1E2E" Margin="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <TextBlock Text="ダブルウィンドウ（画面分割）の使い方" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,8"/>
                            
                            <Border Background="#252538" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="🖥️ アプリを自由にリサイズ・移動できます" FontSize="13" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,0,0,4"/>
                                    <TextBlock Text="ウィンドウの端をドラッグして自由なサイズに変更できます。Windowsキー ＋ 左右矢印キーで画面半分に簡単に配置できます。" TextWrapping="Wrap" FontSize="11" Margin="0,2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Log Console -->
        <Border Grid.Row="2" Background="#181825" CornerRadius="8" Padding="8" Margin="0,6,0,8">
            <DockPanel>
                <TextBlock Text="STATUS LOG" DockPanel.Dock="Top" FontSize="10" FontWeight="Bold" Foreground="#A6ADC8" Margin="0,0,0,2"/>
                <TextBox x:Name="LogConsole" Height="55" IsReadOnly="True" Background="Transparent" Foreground="#F5E0DC" BorderThickness="0" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <!-- Control Action Bar -->
        <Border Grid.Row="3" Background="#1E1E2E" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Typed:" FontSize="11" Foreground="#A6ADC8" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TypedCountText" Text="0 chars" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="StartBtn" Content="▶ 開始 (F8)" Click="StartBtn_Click" Background="#A6E3A1" Foreground="#11111B" Width="100" Margin="0,0,6,0" FontSize="12"/>
                    <Button x:Name="PauseBtn" Content="⏸ 一時停止 (F9)" Click="PauseBtn_Click" Background="#FAB387" Foreground="#11111B" Width="110" Margin="0,0,6,0" IsEnabled="False" FontSize="12"/>
                    <Button x:Name="StopBtn" Content="⏹ 停止 (F10)" Click="StopBtn_Click" Background="#F38BA8" Foreground="#11111B" Width="95" IsEnabled="False" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
