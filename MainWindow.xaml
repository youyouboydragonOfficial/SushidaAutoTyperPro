<Window x:Class="SushidaAutoTyper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sushida &amp; Typing Game Auto-Typer Pro"
        Height="800" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="#11111B"
        Foreground="#CDD6F4"
        FontFamily="Segoe UI, Segoe UI Variable">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E1E2E"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="🍣" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sushida &amp; Typing Game Auto-Typer Pro" FontSize="18" FontWeight="Bold" Foreground="#00E5FF"/>
                        <TextBlock Text="寿司打・Unityゲーム・Webタイピング対応 自動高速タイピング v1.0.0" FontSize="11" Foreground="#A6ADC8"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="📌 デスクトップに追加" Click="CreateShortcutYes_Click" Background="#313244" Foreground="#89B4FA" FontSize="11" Padding="8,4" Margin="0,0,10,0" ToolTip="ホーム画面（デスクトップ）に起動ショートカットを作成"/>
                    <Border Background="#313244" CornerRadius="12" Padding="10,4">
                        <TextBlock Text="F8: 開始 | F9: 一時停止 | F10: 緊急停止" FontSize="11" Foreground="#F5E0DC" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            
            <!-- TAB 1: OCR Screen Recognition -->
            <TabItem Header="📸 画面OCR自動連打モード">
                <Grid Background="#1E1E2E" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="12">

                        <!-- Desktop Shortcut Prompt Banner -->
                        <Border x:Name="ShortcutPromptBanner" Background="#252538" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed" BorderBrush="#00E5FF" BorderThickness="1">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="📌" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="ホーム画面（デスクトップ）にショートカットを追加しますか？" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button Content="いる (はい)" Click="CreateShortcutYes_Click" Background="#A6E3A1" Foreground="#11111B" Margin="0,0,8,0" Padding="14,6"/>
                                    <Button Content="いらない (いいえ)" Click="CreateShortcutNo_Click" Background="#45475A" Foreground="#FFFFFF" Padding="12,6"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Region Selector Box -->
                        <Border Background="#252538" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="1. 画面タイピングエリアの範囲指定" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="RegionStatusText" Text="未選択 (「🎯 領域を選択」を押して寿司打のローマ字表示枠をドラッグ選択してください)" FontSize="12" Foreground="#BAC2DE" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="SelectRegionBtn" Content="🎯 領域を選択" Click="SelectRegionBtn_Click" Background="#89B4FA" Foreground="#11111B" Margin="0,0,6,0"/>
                                    <Button x:Name="TestOcrBtn" Content="🔍 テスト認識" Click="TestOcrBtn_Click" Background="#CBA6F7" Foreground="#11111B"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Key Injection Engine Options -->
                        <Border Background="#252538" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="キー入力モード (Key Injection Mode)" FontSize="12" FontWeight="Bold" Foreground="#00E5FF"/>
                                    <ComboBox x:Name="InputModeComboBox" Margin="0,4,0,0" Padding="6,4" Background="#181825" Foreground="#FFFFFF">
                                        <ComboBoxItem Content="🌐 標準Webブラウザ・寿司打用 (標準VK+ScanCode)" IsSelected="True"/>
                                        <ComboBoxItem Content="🎮 Unity PC・DirectInput専用 (ScanCode Only)"/>
                                        <ComboBoxItem Content="🛠️ 互換性レガシーモード (keybd_event)"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <CheckBox x:Name="AutoFocusCheckBox" Content="🎯 開始時にゲーム画面を自動フォーカス (推奨)" IsChecked="True" Foreground="#A6E3A1" FontWeight="Bold"/>
                                    <CheckBox x:Name="ForceLowercaseCheckBox" Content="🔤 小文字へ自動統一 (寿司打用・タイプミス防止)" IsChecked="True" Foreground="#00E5FF" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Scan Options -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Background="#252538" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="スキャン速度 (Interval)" FontSize="12" Foreground="#A6ADC8"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock x:Name="ScanIntervalValText" Text="100 ms" DockPanel.Dock="Right" Foreground="#00E5FF" FontWeight="Bold"/>
                                        <Slider x:Name="ScanIntervalSlider" Minimum="20" Maximum="500" Value="100" SmallChange="10" ValueChanged="ScanIntervalSlider_ValueChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#252538" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="タイピング打鍵間隔 (Keystroke Delay)" FontSize="12" Foreground="#A6ADC8"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock x:Name="DelayValText" Text="20 ms" DockPanel.Dock="Right" Foreground="#00E5FF" FontWeight="Bold"/>
                                        <Slider x:Name="DelaySlider" Minimum="0" Maximum="300" Value="20" SmallChange="5" ValueChanged="DelaySlider_ValueChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Live Image & Text Preview Box -->
                    <Grid Grid.Row="1" Margin="12,0,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Live Captured Image Box -->
                        <Border Grid.Row="0" Background="#252538" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock Text="📸 リアルタイムキャプチャ画面（長文も途切れず表示）:" DockPanel.Dock="Top" FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,6"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="70" Background="#181825">
                                    <Image x:Name="CapturedScreenImage" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Live OCR Text Box -->
                        <Border Grid.Row="1" Background="#252538" CornerRadius="8" Padding="10">
                            <DockPanel>
                                <TextBlock Text="🔤 認識されたテキスト (OCR Result):" DockPanel.Dock="Top" FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,6"/>
                                <TextBox x:Name="OcrPreviewBox" IsReadOnly="True" Background="#181825" Foreground="#A6E3A1" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Padding="10" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: Direct Custom Text Typing -->
            <TabItem Header="⌨️ 高速テキストタイピングモード">
                <Grid Background="#1E1E2E" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#252538" CornerRadius="8" Padding="14" Margin="12">
                        <StackPanel>
                            <TextBlock Text="自動送信オプション" FontSize="12" Foreground="#A6ADC8"/>
                            <CheckBox x:Name="HumanizerCheckBox" Content="👤 人間らしい揺らぎ (ランダムディレイ)" IsChecked="False" Foreground="#CDD6F4" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="#252538" CornerRadius="8" Padding="14" Margin="12,0,12,12">
                        <DockPanel>
                            <TextBlock Text="自動送信するテキストを入力または貼り付けしてください:" DockPanel.Dock="Top" FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,6"/>
                            <TextBox x:Name="CustomScriptInput" AcceptsReturn="True" TextWrapping="Wrap" Background="#181825" Foreground="#CDD6F4" FontFamily="Consolas" FontSize="14" Padding="10" VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,0,12,12" HorizontalAlignment="Right">
                        <Button Content="ひらがな→ローマ字変換" Click="ConvertKanaBtn_Click" Background="#CBA6F7" Foreground="#11111B" Margin="0,0,8,0"/>
                        <Button Content="テキストクリア" Click="ClearTextBtn_Click" Background="#45475A"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: Sushida Helper & Manual -->
            <TabItem Header="ℹ️ トラブルシューティングガイド">
                <Grid Background="#1E1E2E" Margin="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <TextBlock Text="自動タイピングトラブルシューティング" FontSize="16" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,10"/>
                            
                            <Border Background="#252538" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📌 ホーム画面（デスクトップ）ショートカット作成について" FontSize="14" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,6"/>
                                    <TextBlock Text="ヘッダー右上の「📌 デスクトップに追加」ボタンを押すと、ホーム画面に本アプリの起動用ショートカットが追加されます。" TextWrapping="Wrap" FontSize="12" Margin="0,2"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#252538" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🔤 タイプミス連打・大文字送信が起きる場合" FontSize="14" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,0,0,6"/>
                                    <TextBlock Text="「🔤 小文字へ自動統一」のチェックボックスをオンにしてください。寿司打の文字は全小文字のため、大文字判定によるShiftキータイプミスを100%防止します。" TextWrapping="Wrap" FontSize="12" Margin="0,2"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#252538" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📸 高級コース等の「長文」でキャプチャ枠が収まらない場合" FontSize="14" FontWeight="Bold" Foreground="#FAB387" Margin="0,0,0,6"/>
                                    <TextBlock Text="プレビュー領域が横スクロール対応に刷新されました。どれだけ横長にドラッグ指定しても文字が途切れることなく端まで完全に撮影・認識されます。" TextWrapping="Wrap" FontSize="12" Margin="0,2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Log Console -->
        <Border Grid.Row="2" Background="#181825" CornerRadius="8" Padding="10" Margin="0,8,0,10">
            <DockPanel>
                <TextBlock Text="STATUS LOG" DockPanel.Dock="Top" FontSize="10" FontWeight="Bold" Foreground="#A6ADC8" Margin="0,0,0,4"/>
                <TextBox x:Name="LogConsole" Height="65" IsReadOnly="True" Background="Transparent" Foreground="#F5E0DC" BorderThickness="0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <!-- Control Action Bar -->
        <Border Grid.Row="3" Background="#1E1E2E" CornerRadius="10" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Typed:" FontSize="12" Foreground="#A6ADC8" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TypedCountText" Text="0 chars" FontSize="12" FontWeight="Bold" Foreground="#00E5FF"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="StartBtn" Content="▶ 開始 (F8)" Click="StartBtn_Click" Background="#A6E3A1" Foreground="#11111B" Width="120" Margin="0,0,8,0"/>
                    <Button x:Name="PauseBtn" Content="⏸ 一時停止 (F9)" Click="PauseBtn_Click" Background="#FAB387" Foreground="#11111B" Width="130" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button x:Name="StopBtn" Content="⏹ 停止 (F10)" Click="StopBtn_Click" Background="#F38BA8" Foreground="#11111B" Width="110" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
